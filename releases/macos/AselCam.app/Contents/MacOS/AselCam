#!/usr/bin/env bash
# AselCam macOS Native Launcher
# Runs AselCam Studio with native macOS dark theme and CoreMedia virtual camera support.

set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RES_DIR="$DIR/Resources"
VENV_DIR="$RES_DIR/.venv"

# 1. Locate Python 3
PYTHON_BIN=""
if [ -x "$VENV_DIR/bin/python3" ]; then
    PYTHON_BIN="$VENV_DIR/bin/python3"
elif command -v python3 &>/dev/null; then
    PYTHON_BIN="$(command -v python3)"
elif [ -x "/opt/homebrew/bin/python3" ]; then
    PYTHON_BIN="/opt/homebrew/bin/python3"
elif [ -x "/usr/local/bin/python3" ]; then
    PYTHON_BIN="/usr/local/bin/python3"
elif [ -x "/usr/bin/python3" ]; then
    PYTHON_BIN="/usr/bin/python3"
fi

if [ -z "$PYTHON_BIN" ]; then
    osascript -e 'display alert "AselCam requires Python 3" message "Please install Python 3 to run AselCam on your Mac.\n\nOpen Terminal and run:\nbrew install python"'
    exit 1
fi

# 2. Setup isolated virtual environment if missing
if [ ! -d "$VENV_DIR" ]; then
    osascript -e 'display notification "Configuring AselCam Studio environment..." with title "AselCam"' 2>/dev/null || true
    "$PYTHON_BIN" -m venv "$VENV_DIR"
    "$VENV_DIR/bin/pip" install --upgrade pip
    "$VENV_DIR/bin/pip" install -q -r "$RES_DIR/requirements.txt"
fi

# 3. Automatically configure Direct Virtual Camera Driver in user DAL
USER_DAL="$HOME/Library/CoreMediaIO/Plug-Ins/DAL"
DRIVER_SOURCE="$RES_DIR/aselcam/drivers/macos/obs-mac-virtualcam.plugin"
if [ -d "$DRIVER_SOURCE" ] && [ ! -d "$USER_DAL/obs-mac-virtualcam.plugin" ]; then
    mkdir -p "$USER_DAL"
    cp -R "$DRIVER_SOURCE" "$USER_DAL/" 2>/dev/null || true
    xattr -cr "$USER_DAL/obs-mac-virtualcam.plugin" 2>/dev/null || true
fi

# 4. Launch AselCam Studio
export PYTHONPATH="$RES_DIR:$PYTHONPATH"
cd "$RES_DIR"
exec "$VENV_DIR/bin/python3" -m aselcam.main "$@"
